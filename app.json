{
  "expo": {
    "owner": "savran.juli",
    "name": "MeTravel",
    "slug": "metravel",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "metravel",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/fonts/*",
      "assets/travel/*",
      "assets/icons/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "by.metravel.app",
      "buildNumber": "6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MeTravel uses your location to show nearby routes, places, and quest points.",
        "NSMotionUsageDescription": "MeTravel uses motion data to support location and direction features while you navigate routes and quests.",
        "NSPhotoLibraryUsageDescription": "MeTravel accesses photos you choose so you can add them to your profile, trips, and articles.",
        "NSCameraUsageDescription": "MeTravel uses the camera when you choose to take a photo for your profile, trip, or article.",
        "NSFaceIDUsageDescription": "MeTravel uses Face ID only when you choose biometric sign-in.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:metravel.by"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "by.metravel.app",
      "versionCode": 21,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "metravel.by",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/logo_yellow_60x60.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://metravel.by",
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "MeTravel uses your location to show nearby routes, places, and quest points.",
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": "MeTravel uses motion data to support location and direction features while you navigate routes and quests."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MeTravel accesses photos you choose so you can add them to your profile, trips, and articles.",
          "cameraPermission": "MeTravel uses the camera when you choose to take a photo for your profile, trip, or article.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MeTravel accesses photos you choose so you can add them to your profile, trips, and articles.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#1a1a2e"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MeTravel uses Face ID only when you choose biometric sign-in."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "./plugins/withAndroidShortcuts",
      "./plugins/withAndroidReleaseSafety",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7a9d8f",
          "defaultChannel": "updates",
          "mode": "production",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "react-native-fbsdk-next",
      "expo-video"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "472c9f49-998e-43c5-bf37-0478cf259645"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
