# Креды для разовых операций с медиа-хранилищем.
#
# Скопируй в `.env.media-ops` и заполни. Сам `.env.media-ops` в git не попадёт
# (`.gitignore` игнорирует `.env*`), этот файл-шаблон — попадёт. Значения в чат
# вставлять не нужно: скрипты читают их из окружения.
#
# Запуск:
#   set -a && source .env.media-ops && set +a
#   python3 scripts/backup_media_storage.py
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. БЭКАП ХРАНИЛИЩА  —  scripts/backup_media_storage.py
# ─────────────────────────────────────────────────────────────────────────────
# Креды НУЖНЫ для перечисления. 2026-07-30 по #1158 анонимный листинг закрыт
# (у `AllUsers` снят грант `List` в ACL бакета), `?list-type=2` отдаёт 403.
# Доставь `pip install boto3` и заполни блок ниже. Ключ нужен ТОЛЬКО НА ЧТЕНИЕ:
# заведи отдельный IAM-ключ с `s3:ListBucket` + `s3:GetObject` на этот бакет и
# больше ни с чем. Права на запись/удаление для бэкапа не требуются и выдавать
# их не надо.
#
# Без ключей скрипт всё ещё работает в режиме докачки и `--verify`, но только по
# уже сохранённой описи `.backup/s3/inventory.json` — новые объекты в неё не
# попадут. Полная опись на 2026-07-30 снята: 57 163 объекта, 11.16 ГиБ, сверка
# `--verify` зелёная.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
MEDIA_S3_BUCKET=metravelprod

# Куда складывать бэкап. Нужно ~12 ГиБ свободного места (в бакете 57 163 объекта
# / 11.16 ГиБ на 2026-07-30). По умолчанию — `.backup/s3/` внутри репозитория.
# MEDIA_BACKUP_DIR=/Volumes/External/metravel-media-backup

# ─────────────────────────────────────────────────────────────────────────────
# 2. НОРМАЛИЗАЦИЯ ОБЛОЖЕК КВЕСТОВ  —  scripts/normalize_quest_covers_prod.py
# ─────────────────────────────────────────────────────────────────────────────
# DRF-токен пользователя с правом менять квесты (superuser или владелец).
# Скрипт делает `PATCH /api/quests/{id}/` с полем `cover_image`; заливка
# проходит через серверный ресайз, поэтому правок бэкенда не требуется.
#
# ВАЖНО: без этого токена скрипт работает только в режиме отчёта (dry-run) —
# так и задумано, мутация требует явного `--apply`.

METRAVEL_API_TOKEN=

# База API. Меняй только если гоняешь против дева, а не прода.
# METRAVEL_API_BASE=https://metravel.by
