+
+let spikeFetchCount = 0
+async function fetchTravelForParams(params: Record<string, string | string[]>) {
+  const raw = Array.isArray(params.param) ? params.param[0] : params.param
+  const segment = toRealSegment(decodeURIComponent(String(raw ?? '')))
+  const isId = /^[1-9][0-9]*$/.test(segment)
+  const url = isId
+    ? `${SPIKE_API}/api/travels/${segment}/`
+    : `${SPIKE_API}/api/travels/by-slug/${encodeURIComponent(segment)}/`
+  const t0 = Date.now()
+  const res = await fetch(url, { headers: { Accept: 'application/json' } })
+  spikeFetchCount += 1
+  if (process.env.SPIKE_LOADER_LOG) console.log(`[spike-loader] #${spikeFetchCount} ${segment} ${res.status} ${Date.now() - t0}ms`)
+  if (!res.ok) return { travel: null, status: res.status }
+  return { travel: await res.json() }
+}
+
+export async function loader(_request: unknown, params: Record<string, string | string[]>) {
+  return fetchTravelForParams(params)
