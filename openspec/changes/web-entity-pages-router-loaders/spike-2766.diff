@@ -0,0 +1,25 @@
+// #2766 spike: экран маршрута путешествия; файл маршрута грузит его динамически,
+// чтобы бандл loader (исполняется на каждый путь при экспорте) оставался крошечным.
+import { useLoaderData } from 'expo-router'
+import { Platform } from 'react-native'
+import { useAndroidBackHandler } from '@/hooks/useAndroidBackHandler'
+import TravelDetailsContainer from '@/components/travel/details/TravelDetailsContainer'
+import { TravelLoaderDataContext, type TravelLoaderPayload } from '@/components/travel/details/travelLoaderData'
+import { normalizeTravelItem } from '@/api/travelsNormalize'
+import { getTravelDetailsSeoViewModel } from '@/components/travel/details/hooks/travelDetailsContainerViewModel'
+import { stringifyJsonLd } from '@/utils/jsonLd'
+
+export default function TravelRouteScreen() {
+  useAndroidBackHandler()
+  const payload = useLoaderData() as TravelLoaderPayload
+  const travel = payload?.travel ? normalizeTravelItem(payload.travel) : null
+  const jsonLd = travel ? getTravelDetailsSeoViewModel(travel, String(travel.slug ?? '')).jsonLd : null
+  return (
+    <TravelLoaderDataContext.Provider value={payload}>
+      {Platform.OS === 'web' && jsonLd ? (
+        <script type="application/ld+json" data-seo-jsonld="travel-article" dangerouslySetInnerHTML={{ __html: stringifyJsonLd(jsonLd) }} />
+      ) : null}
+      <TravelDetailsContainer />
+    </TravelLoaderDataContext.Provider>
+  )
+}
