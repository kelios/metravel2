+// #2766 spike: head статьи для generateMetadata (грузится динамически из файла маршрута).
+import { normalizeTravelItem } from '@/api/travelsNormalize'
+import { getTravelDetailsSeoViewModel } from '@/components/travel/details/hooks/travelDetailsContainerViewModel'
+import { routeMetadata, shellRouteMetadata } from '@/utils/seoRoutes/routeMetadata'
+
+export function buildTravelRouteMetadata(raw: unknown) {
+  if (!raw) return shellRouteMetadata()
+  const travel = normalizeTravelItem(raw)
+  const seo = getTravelDetailsSeoViewModel(travel, String(travel.slug ?? ''))
+  return routeMetadata({
+    title: seo.readyTitle ?? 'Metravel',
+    description: seo.readyDesc ?? undefined,
+    canonical: seo.canonicalUrl,
+    image: seo.readyImage,
+    ogType: 'article',
+  })
+}
+
+export { shellRouteMetadata }
