+// #2766 spike: данные статьи из штатного loader маршрута (Expo Router 58).
+import { createContext, useContext } from 'react'
+
+export type TravelLoaderPayload = { travel: unknown | null; status?: number } | undefined
+
+export const TravelLoaderDataContext = createContext<TravelLoaderPayload>(undefined)
+
+export function useTravelLoaderPayload(): TravelLoaderPayload {
+  return useContext(TravelLoaderDataContext)
+}
