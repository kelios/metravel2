+
+export async function generateStaticParams(): Promise<{ param: string }[]> {
+  const limit = Number(process.env.SPIKE_TRAVEL_LIMIT || 0)
+  if (!limit) return []
+  const variants = Math.max(1, Number(process.env.SPIKE_TRAVEL_VARIANTS || 1))
+  const where = encodeURIComponent(JSON.stringify({ publish: 1, moderation: 1 }))
+  const slugs: string[] = []
+  for (let page = 1; slugs.length < limit && page < 50; page += 1) {
+    const res = await fetch(`${SPIKE_API}/api/travels/?page=${page}&perPage=100&where=${where}`)
+    const data = (await res.json()) as { results?: { slug?: string }[]; next?: string | null }
+    for (const item of data.results ?? []) if (item.slug && !item.slug.startsWith('local-qa')) slugs.push(item.slug)
+    if (!data.next) break
+  }
+  const first = process.env.SPIKE_TRAVEL_FIRST ? process.env.SPIKE_TRAVEL_FIRST.split(',') : []
+  const base = [...first, ...slugs.filter((s) => !first.includes(s))].slice(0, limit)
+  const out: { param: string }[] = []
+  for (let v = 0; v < variants; v += 1) for (const s of base) out.push({ param: v === 0 ? s : `${s}--s${v}` })
+  return out
 }
 
