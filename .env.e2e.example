# Copy to the ignored .env.e2e and configure a disposable local backend.
E2E_API_URL=http://127.0.0.1:8000
BASE_URL=http://127.0.0.1:8085
E2E_WEB_PORT=8085

# A owns test content; B is the independent applicant/subscriber account.
E2E_EMAIL=owner@example.test
E2E_PASSWORD=YOUR_PRIVATE_OWNER_PASSWORD
E2E_EMAIL2=applicant@example.test
E2E_PASSWORD2=YOUR_PRIVATE_APPLICANT_PASSWORD

# C is a third, dedicated account: successful logout revokes its token.
# Never reuse A/B here or replace their credentials/API token with C.
E2E_LOGOUT_EMAIL=logout@example.test
E2E_LOGOUT_PASSWORD=YOUR_PRIVATE_LOGOUT_PASSWORD

# Explicitly opt in only when running mutations against the disposable backend.
E2E_ALLOW_LIVE_MUTATIONS=0
