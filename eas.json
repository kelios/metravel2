{
  "cli": {
    "version": "21.8.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.1",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "scheme": "metravel",
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.1",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "scheme": "metravel",
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "node": "22.13.1",
      "environment": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metravel.by",
        "PROD_API_URL": "https://metravel.by"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "scheme": "metravel",
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "by.metravel.app"
      }
    }
  }
}
