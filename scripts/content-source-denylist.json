    { "id": "belsat", "label": "«Белсат»", "regex": "белсат|biełsat|belsat" },
    { "id": "euroradio", "label": "«Еврорадио»", "regex": "еврорадио|еўрарадыё|euroradio" },
    { "id": "charter97", "label": "«Хартия'97»", "regex": "хартия\\s*['’]?\\s*97|хартыя|charter\\s*97|charter97" },
    { "id": "nash-krai", "label": "«Наш Край»", "regex": "[«\"„]наш\\s+кра[йі][»\"“]" },
    { "id": "salidarnasc", "label": "«Салідарнасць»", "regex": "салідарнасць|салидарнасць|gazetaby" },
    { "id": "belpartisan", "label": "«Белорусский партизан»", "regex": "белорусский\\s+партизан|belaruspartisan" },
    { "id": "novy-chas", "label": "«Новы Час»", "regex": "[«\"„]новы\\s+час[»\"“]|novychas" }
