{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__metravel-task-board__metravel_task_create|mcp__metravel-task-board__metravel_task_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/task-quality-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "Гейт качества карточки борда"
          }
        ]
      },
      {
        "matcher": "mcp__metravel-task-board__metravel_task_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "Код-ревью гейт перед testing"
          }
        ]
      },
      {
        "matcher": "mcp__metravel-task-board__metravel_task_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/task-claim.mjs\"",
            "timeout": 15,
            "statusMessage": "Гейт занятости карточки"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__metravel-task-board__metravel_task_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "Автозапуск ревью/приёмки по статусу борда"
          }
        ]
      },
      {
        "matcher": "mcp__metravel-task-board__metravel_task_update|mcp__metravel-task-board__metravel_task_get",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/task-claim.mjs\"",
            "timeout": 15,
            "statusMessage": "Claim карточки и проверка чужих сессий"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "metravel-task-board"
  ],
  "permissions": {
    "allow": [
      "Bash(node .claude/hooks/review-gate.mjs *)",
      "Bash(node .claude/hooks/task-quality-gate.mjs *)",
      "Bash(node scripts/audit-board-tasks.mjs *)"
    ]
  }
}
